angle_deg = -44.4
indices = [8.0, 24.0, 40.0, 56.0, 72.0]
tier_id = 4
note = "Five corner guards, cut to the girdle corners; they keep the girdle level."

[[tiers]]
name = "C1 Five broad bezels"
