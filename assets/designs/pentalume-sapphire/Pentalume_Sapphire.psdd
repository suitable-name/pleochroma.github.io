tier_id = 2
note = "Ten narrow splits beside the mains, cut to the culet point."

[[tiers]]
name = "G2 Five clipping flats"
constraint = { kind = "scale_reference", mast = 1.1280169178 }
angle_deg = 90.0
indices = [8.0, 24.0, 40.0, 56.0, 72.0]
tier_id = 3
note = "Five short corner flats, cut to the points where the mains and splits reach the girdle line."

[[tiers]]
name = "P3 Five corner guards"
