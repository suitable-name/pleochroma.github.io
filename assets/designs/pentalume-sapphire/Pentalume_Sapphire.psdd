format = "pleochroma-design"
version = 1
girdle_diameter_mm = 10.0

[meta]
title = "Pentalume Sapphire"
designer = "Niklas Gussek"
shape = "Clipped pentagon"
notes = "Five broad blue sectors and protected corners. Every tier is cut to a meet point, and the girdle is level. Cut in sapphire with the c-axis normal to the table."

[preform]
shape = { kind = "block" }
half_width = 1.25
length_over_width = 1.0
depth = 1.4344077607184649
y_offset = -0.33098855265923244

[material]
name = "Sapphire"

[schedule]
gemcad_version = "5.0"
gear_teeth = 80
gear_reference_angle = 0.0
symmetry_order = 5
mirror = true
refractive_index = 1.7681
headers = ["Pentalume Sapphire", "Designed by Niklas Gussek"]
footnotes = []

[[tiers]]
name = "P1 Five broad mains"
constraint = { kind = "scale_reference", mast = 0.7320997926 }
angle_deg = -44.6
indices = [0.0, 16.0, 32.0, 48.0, 64.0]
tier_id = 0
note = "Five main sectors meet at the central culet."

[[tiers]]
